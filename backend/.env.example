NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.<cluster-id>.mongodb.net/royal_cuts?retryWrites=true&w=majority&appName=RoyalCuts
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Comma-separated browser origins if the frontend is hosted separately.
CORS_ORIGIN=

# Set these privately before running `npm run create-admin`; no defaults are provided.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
